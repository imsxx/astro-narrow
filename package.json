{
  "name": "astro-narrow",
  "version": "1.2.0",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "description": "An Astro port of the hugo-narrow theme",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "i18n": "node scripts/build-i18n.mjs && biome format --write src/i18n",
    "upstream:pull": "bash scripts/upstream-pull.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.4.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.17",
    "hastscript": "^9.0.1",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "tailwind",
    "hugo-narrow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imsxx/astro-narrow"
  },
  "bugs": {
    "url": "https://github.com/imsxx/astro-narrow/issues"
  },
  "homepage": "https://github.com/imsxx/astro-narrow#readme"
}
