---
import { t } from "@/i18n"

type Props = {
  title: string
  viewAllHref?: string
}

const { title, viewAllHref } = Astro.props
---

<div class="mb-4 flex items-baseline justify-between gap-3">
  <h2 class="text-foreground text-xl font-semibold tracking-tight">{title}</h2>
  {viewAllHref && (
      <a
        href={viewAllHref}
        class="text-muted-foreground hover:text-foreground text-sm transition-colors"
      >
        {t.home.viewAll}
      </a>
    )}
</div>
