---
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import SectionHeader from "@/components/content/SectionHeader.astro"
import { siteConfig } from "@/config/site"
import { getRelated, summaryOf, type Post } from "@/lib/posts"
import { t } from "@/i18n"

type Props = {
  post: Post
}

const { post } = Astro.props
const related = siteConfig.post.showRelated
  ? await getRelated(post, siteConfig.post.relatedPostsCount)
  : []
---

{
  related.length > 0 && (
    <section class="mt-12">
      <SectionHeader title={t.article.relatedContent} />
      <CardGrid columns={related.length >= 3 ? 3 : 2}>
        {related.map((entry) => (
          <Card
            title={entry.data.title}
            href={`/posts/${entry.id}/`}
            summary={summaryOf(entry, 100)}
            date={entry.data.date}
            tags={entry.data.tags}
          />
        ))}
      </CardGrid>
    </section>
  )
}
