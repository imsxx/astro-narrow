---
import Icon from "@/components/Icon.astro"
import { formatDate, isoDate } from "@/lib/date"

type Props = {
  title: string
  href: string
  summary?: string
  date?: Date
  tags?: string[]
  count?: number
  external?: string
  compact?: boolean
  variant?: "post" | "series"
}

const {
  title,
  href,
  summary,
  date,
  tags,
  count,
  external,
  compact = false,
  variant = "post",
} = Astro.props

const hasMeta = Boolean(date) || Boolean(tags?.length) || Boolean(count)
import { url } from "@/lib/url"
---

<article class="group relative h-full" data-card={variant}>
  <div
    class:list={[
      "border-border bg-card hover:bg-accent/20 hover:border-primary/30 flex h-full flex-col justify-between rounded-lg border transition-colors",
      compact ? "gap-2 p-4" : "gap-3 p-5",
    ]}
  >
    <div class="flex items-start justify-between gap-3">
      <h3
        class:list={[
          "text-foreground leading-snug font-semibold",
          compact ? "text-sm" : "text-base",
        ]}
      >
        <a href={url(href)} class="after:absolute after:inset-0">{title}</a>
      </h3>

      {external ? (
          <a
            href={external}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title}
            title={title}
            class="text-muted-foreground hover:text-foreground hover:bg-muted relative z-10 -mt-1 -mr-1 inline-flex size-8 shrink-0 items-center justify-center rounded-md transition-colors"
          >
            <Icon name="github" size="sm" />
          </a>
        ) : (
          <span
            class="text-muted-foreground group-hover:text-foreground mt-0.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            <Icon name="arrow-right" size="sm" class="icon-directional" />
          </span>
        )}
    </div>

    {summary && (
        <p class="text-muted-foreground line-clamp-2 text-sm leading-relaxed">
          {summary}
        </p>
      )}

    {hasMeta && (
        <div class="text-muted-foreground mt-auto flex flex-wrap items-center gap-x-3 gap-y-1.5 pt-1 text-xs">
          {date && (
            <time datetime={isoDate(date)} class="tabular-nums">
              {formatDate(date, "short")}
            </time>
          )}

          {count !== undefined && (
            <span class="border-border bg-muted/40 rounded-sm border px-1.5 py-0.5 tabular-nums">
              {count} 篇
            </span>
          )}

          {tags && tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5">
              {tags.slice(0, 3).map((tag) => (
                <span class="border-border bg-muted/40 rounded-sm border px-1.5 py-0.5 text-xs">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      )}
  </div>
</article>
