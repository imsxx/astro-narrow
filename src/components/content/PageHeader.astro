---
type Props = {
  title: string
  description?: string
  meta?: string
}

const { title, description, meta } = Astro.props
---

<header class="border-border mb-8 border-b pb-6">
  <h1 class="text-foreground text-2xl font-semibold tracking-tight md:text-3xl">
    {title}
  </h1>

  {description && (
      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{description}</p>
    )}

  {meta && <p class="text-muted-foreground mt-3 text-xs">{meta}</p>}

  <slot />
</header>
