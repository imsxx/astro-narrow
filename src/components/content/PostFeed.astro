---
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import Pagination from "@/components/navigation/Pagination.astro"
import { summaryOf, type Post } from "@/lib/posts"
import { t } from "@/i18n"

type Props = {
  posts: Post[]
  base: string
  current: number
  totalPages: number
}

const { posts, base, current, totalPages } = Astro.props
import { url } from "@/lib/url"
---

{posts.length > 0 ? (
    <>
      <CardGrid columns={1}>
        {posts.map((post) => (
          <Card
            title={post.data.title}
            href={url(`/posts/${post.id}/`)}
            summary={summaryOf(post)}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </CardGrid>
      <Pagination base={base} current={current} totalPages={totalPages} />
    </>
  ) : (
    <p class="text-muted-foreground py-8 text-sm">{t.article.empty}</p>
  )}
