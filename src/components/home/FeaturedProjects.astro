---
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import SectionHeader from "@/components/content/SectionHeader.astro"
import { getFeaturedProjects, getProjects } from "@/lib/projects"
import { t } from "@/i18n"
import { url } from "@/lib/url"

const featured = await getFeaturedProjects()
const total = (await getProjects()).length
---

{featured.length > 0 && (
  <section class="featured-projects">
    <SectionHeader
      title={t.home.featuredProjects}
      viewAllHref={total > featured.length ? url("/projects") : undefined}
    />
    <CardGrid columns={2}>
      {featured.map((project) => (
        <Card
          variant="post"
          title={project.data.title}
          href={url(`/projects/${project.id}/`)}
          summary={project.data.summary ?? project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          external={project.data.link}
        />
      ))}
    </CardGrid>
  </section>
)}
