---
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import SectionHeader from "@/components/content/SectionHeader.astro"
import { siteConfig } from "@/config/site"
import { getPosts, summaryOf } from "@/lib/posts"
import { t } from "@/i18n"
import { url } from "@/lib/url"

const posts = await getPosts()
const recent = posts.slice(0, siteConfig.home.recentPostsCount)
---

<section class="post-list">
  <SectionHeader title={t.home.recentPosts} viewAllHref={url("/posts")} />
  <CardGrid columns={1}>
    {recent.map((post) => (
      <Card
        variant="post"
        title={post.data.title}
        href={url(`/posts/${post.id}/`)}
        summary={summaryOf(post)}
        date={post.data.date}
        tags={post.data.tags}
      />
    ))}
  </CardGrid>
</section>
