---
import Icon from "@/components/Icon.astro"
import { pageUrl, pageWindow } from "@/lib/pagination"
import { t } from "@/i18n"

type Props = {
  base: string
  current: number
  totalPages: number
}

const { base, current, totalPages } = Astro.props
const pages = pageWindow(current, totalPages)

const linkClass =
  "border-border text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex size-8 items-center justify-center rounded-md border text-sm transition-colors"
const navClass =
  "border-border text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex h-8 items-center gap-1 rounded-md border px-2 text-sm transition-colors"
const disabledClass =
  "border-border text-muted-foreground/40 inline-flex h-8 cursor-not-allowed items-center gap-1 rounded-md border px-2 text-sm"
---

{totalPages > 1 && (
    <nav
      class="mt-10 flex items-center justify-between gap-2"
      aria-label={t.nav.pageInfo(current, totalPages)}
    >
      {current > 1 ? (
        <a href={pageUrl(base, current - 1)} class={navClass} aria-label={t.nav.prev}>
          <Icon name="chevron-left" size="sm" class="icon-directional" />
          <span class="hidden sm:inline">{t.nav.prev}</span>
        </a>
      ) : (
        <span class={disabledClass}>
          <Icon name="chevron-left" size="sm" class="icon-directional" />
          <span class="hidden sm:inline">{t.nav.prev}</span>
        </span>
      )}

      <div class="flex items-center gap-1">
        {pages.map((page) =>
          page === null ? (
            <span class="text-muted-foreground px-1 text-sm">…</span>
          ) : page === current ? (
            <span
              class="bg-primary text-primary-foreground inline-flex size-8 items-center justify-center rounded-md text-sm font-medium"
              aria-current="page"
            >
              {page}
            </span>
          ) : (
            <a href={pageUrl(base, page)} class={linkClass}>
              {page}
            </a>
          ),
        )}
      </div>

      {current < totalPages ? (
        <a href={pageUrl(base, current + 1)} class={navClass} aria-label={t.nav.next}>
          <span class="hidden sm:inline">{t.nav.next}</span>
          <Icon name="chevron-right" size="sm" class="icon-directional" />
        </a>
      ) : (
        <span class={disabledClass}>
          <span class="hidden sm:inline">{t.nav.next}</span>
          <Icon name="chevron-right" size="sm" class="icon-directional" />
        </span>
      )}
    </nav>
  )}
