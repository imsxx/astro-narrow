---
type Props = {
  vid: string
}

const { vid } = Astro.props
---

<div class="bg-card border-border my-8 overflow-hidden rounded-md border">
  <div class="aspect-video">
    <iframe
      src={`https://v.qq.com/txp/iframe/player.html?vid=${vid}&auto=0`}
      class="h-full w-full"
      scrolling="no"
      frameborder="no"
      allowfullscreen
      title={`Tencent Video ${vid}`}
    />
  </div>
</div>
