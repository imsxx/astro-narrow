---
type Props = {
  label?: string
  lang?: string
}

const { label, lang } = Astro.props
const text = label ?? (lang ? lang.toUpperCase() : "Tab")
---

<section
  class="tabs-panel outline-none"
  role="tabpanel"
  data-tabs-panel
  data-tab-label={text}
>
  <div
    class="tabs-panel-content px-4 pt-4 *:first:mt-0 *:last:mb-0 [&_.code-block-container:first-child]:mt-0 [&_.code-block-container:last-child]:mb-0"
  >
    <slot />
  </div>
</section>
