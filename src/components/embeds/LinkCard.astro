---
import Icon from "@/components/Icon.astro"

type Props = {
  title: string
  url: string
  description?: string
  icon?: string
}

const { title, url, description, icon } = Astro.props
import { url as withBase } from "@/lib/url"
---

<div class="not-prose my-4 max-w-lg">
  <a
    href={withBase(url)}
    target="_blank"
    rel="noopener noreferrer"
    class="border-border bg-card hover:bg-accent/40 hover:border-primary/30 group flex items-start gap-3 rounded-lg border p-4 transition-colors"
  >
    <span
      class="bg-muted text-muted-foreground flex size-10 shrink-0 items-center justify-center rounded-md"
    >
      <Icon name={icon ?? "link"} size="md" />
    </span>
    <span class="min-w-0 flex-1">
      <span
        class="text-foreground flex items-center gap-1.5 text-sm font-medium"
      >
        <span class="truncate">{title}</span>
        <span
          class="text-muted-foreground group-hover:text-foreground shrink-0 transition-colors"
        >
          <Icon name="external-link" size="xs" />
        </span>
      </span>
      {description && (
          <span class="text-muted-foreground mt-1 line-clamp-2 block text-xs leading-relaxed">
            {description}
          </span>
        )}
    </span>
  </a>
</div>
