---
type Props = {
  vid: string
  page?: number
}

const { vid, page = 1 } = Astro.props

const lower = vid.toLowerCase()
const isAv = lower.startsWith("av")
const isBv = lower.startsWith("bv")

const query = new URLSearchParams({
  page: String(page),
  high_quality: "1",
  as_wide: "1",
})

if (isAv) query.set("aid", lower.slice(2))
else if (isBv) query.set("bvid", vid)
---

{
  isAv || isBv ? (
    <div class="bg-card border-border my-8 overflow-hidden rounded-md border">
      <div class="aspect-video">
        <iframe
          src={`https://player.bilibili.com/player.html?${query.toString()}`}
          class="h-full w-full"
          scrolling="no"
          frameborder="no"
          allowfullscreen
          title={`Bilibili ${vid}`}
        />
      </div>
    </div>
  ) : (
    <div class="bg-caution/10 border-caution/20 my-8 rounded-md border p-4">
      <p class="text-caution font-medium">
        Bilibili 视频 av 号或 BV 号错误，请检查视频编号是否正确
      </p>
      <p class="text-muted-foreground mt-2 text-sm">
        当前视频编号：{vid}，分 P：{page}
      </p>
    </div>
  )
}
