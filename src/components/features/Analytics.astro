---
import { siteConfig } from "@/config/site"

const { provider, google, baidu, clarity, umami } = siteConfig.analytics

const show =
  (provider === "google" && google.id) ||
  (provider === "baidu" && baidu.id) ||
  (provider === "clarity" && clarity.id) ||
  (provider === "umami" && umami.id && umami.src)
---

{show && provider === "google" && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${google.id}`}
      />
      <script is:inline define:vars={{ id: google.id }}>
        window.dataLayer = window.dataLayer || []
        function gtag() {
          dataLayer.push(arguments)
        }
        gtag("js", new Date())
        gtag("config", id)
      </script>
    </>
  )}

{show && provider === "baidu" && (
    <script is:inline define:vars={{ id: baidu.id }}>
      var _hmt = _hmt || []
      ;(() => {
        var hm = document.createElement("script")
        hm.src = "https://hm.baidu.com/hm.js?" + id
        var s = document.getElementsByTagName("script")[0]
        s.parentNode.insertBefore(hm, s)
      })()
    </script>
  )}

{show && provider === "clarity" && (
    <script is:inline define:vars={{ id: clarity.id }}>
      ;(() => {
        var c = document.createElement("script")
        c.async = true
        c.src = "https://www.clarity.ms/tag/" + id
        var s = document.getElementsByTagName("script")[0]
        s.parentNode.insertBefore(c, s)
      })()
    </script>
  )}

{show && provider === "umami" && (
    <script
      is:inline
      defer
      src={umami.src}
      data-website-id={umami.id}
      data-domains={umami.domains || undefined}
    />
  )}
