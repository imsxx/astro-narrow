---
import Icon from "@/components/Icon.astro"
import { siteConfig } from "@/config/site"
import { t } from "@/i18n"

const { announcement } = siteConfig
const show = announcement.enabled && announcement.message.trim().length > 0

const tone =
  announcement.type === "warning"
    ? "border-warning/30 bg-warning/10"
    : announcement.type === "destructive"
      ? "border-destructive/30 bg-destructive/10"
      : "border-border bg-popover"

const role = announcement.type === "destructive" ? "alert" : "status"

const id = Array.from(announcement.message)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(16)
  .slice(0, 8)
---

{show && (
    <div
      id="site-announcement"
      class:list={["site-tip", tone]}
      role={role}
      data-announcement-id={id}
    >
      <p class="text-foreground min-w-0 flex-1 text-sm leading-relaxed">
        {announcement.message}
      </p>
      {announcement.dismissible && (
        <button
          id="announcement-close"
          type="button"
          class="text-muted-foreground hover:bg-accent hover:text-accent-foreground -my-1 inline-flex size-7 shrink-0 items-center justify-center rounded-md transition-colors"
          aria-label={t.ui.announcementDismiss}
          title={t.ui.announcementDismiss}
        >
          <Icon name="close" size="sm" />
        </button>
      )}
    </div>
  )}
