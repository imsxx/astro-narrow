---
import Icon from "@/components/Icon.astro"
import { t } from "@/i18n"

type Props = {
  /** Group consecutive images into a grid. */
  gallery?: boolean
  /** Open single images in the lightbox. */
  lightbox?: boolean
}

const { gallery = false, lightbox = false } = Astro.props
---

{(gallery || lightbox) && (
    <script>
      import "@/scripts/gallery.js"
    </script>
  )}

{gallery && (
    <template id="gallery-layout-switcher">
      <div class="gallery-layout-switcher">
        <button
          type="button"
          class="layout-btn"
          aria-label={t.ui.galleryLayoutSwitch}
          title={t.ui.galleryLayoutSwitch}
        >
          <Icon name="layout" size="sm" />
        </button>
      </div>
    </template>
  )}
