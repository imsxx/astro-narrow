---
import { siteConfig } from "@/config/site"
import { t } from "@/i18n"
import CommentsThemeSync from "@/components/features/CommentsThemeSync.astro"

type Props = {
  url?: string
  title?: string
  enabled?: boolean
  /** Provider name; anything outside the list below shows the notice. */
  provider?: string
}

const {
  url = Astro.url.href,
  title = "",
  enabled = siteConfig.comments.enabled,
  provider = siteConfig.comments.provider,
} = Astro.props

const KNOWN = [
  "giscus",
  "disqus",
  "utterances",
  "waline",
  "artalk",
  "twikoo",
  "comentario",
] as const
type Known = (typeof KNOWN)[number]

/** Every key a provider cannot work without; a gap shows the notice instead. */
const required: Record<Known, string[]> = {
  giscus: ["repo", "repoId", "categoryId"],
  disqus: ["shortname"],
  utterances: ["repo"],
  waline: ["serverURL"],
  artalk: ["server"],
  twikoo: ["envId"],
  comentario: ["server"],
}

const isKnown = (KNOWN as readonly string[]).includes(provider)
const path = Astro.url.pathname

/** One warning per build, not one per page. */
const warned = new Set<string>()
if (enabled && provider && isKnown === false && !warned.has(provider)) {
  warned.add(provider)
  console.warn(
    `[comments] comments.provider "${provider}" has no matching block; showing the notice instead.`,
  )
}

const cfg = (
  isKnown ? siteConfig.comments[provider as Known] : {}
) as unknown as Record<string, string | undefined>

const configured =
  enabled &&
  isKnown &&
  required[provider as Known].every((key) => Boolean(cfg[key]))

/** Follow the page theme when the provider is set to its system mode. */
const giscusTheme = cfg.theme || "preferred_color_scheme"
const utterancesTheme = cfg.theme || "preferred-color-scheme"
const artalkDark = cfg.darkMode || "auto"
---

{enabled && provider && (
    <section id="comments" class="border-border mt-10 border-t pt-8">
      <h2 class="text-foreground mb-4 text-lg font-semibold tracking-tight">
        {t.comments.title}
      </h2>

      <div class="comments-container">
        {!configured && (
          <div class="text-muted-foreground py-6 text-sm">
            {t.comments.notConfigured}
          </div>
        )}

        {configured && provider === "giscus" && (
          <div id="giscus-comments" class="giscus-container">
            <script
              is:inline
              src="https://giscus.app/client.js"
              data-repo={cfg.repo}
              data-repo-id={cfg.repoId}
              data-category={cfg.category || "General"}
              data-category-id={cfg.categoryId}
              data-mapping={cfg.mapping || "pathname"}
              data-strict={cfg.strict || "0"}
              data-reactions-enabled={cfg.reactionsEnabled || "1"}
              data-emit-metadata={cfg.emitMetadata || "0"}
              data-input-position={cfg.inputPosition || "bottom"}
              data-theme={giscusTheme}
              data-lang={cfg.lang || "zh-CN"}
              data-loading="lazy"
              crossorigin="anonymous"
              async
            />
          </div>
        )}

        {configured && provider === "disqus" && (
          <div id="disqus-comments" class="disqus-container">
            <div id="disqus_thread" />
            <script
              is:inline
              define:vars={{
                shortname: cfg.shortname,
                pageUrl: url,
                pagePath: path,
                pageTitle: title,
              }}
            >
              var disqus_config = function () {
                this.page.url = pageUrl
                this.page.identifier = pagePath
                this.page.title = pageTitle
              }
              ;(() => {
                const d = document
                const s = d.createElement("script")
                s.src = `https://${shortname}.disqus.com/embed.js`
                s.setAttribute("data-timestamp", String(+new Date()))
                ;(d.head || d.body).appendChild(s)
              })()
            </script>
          </div>
        )}

        {configured && provider === "utterances" && (
          <div id="utterances-comments" class="utterances-container">
            {/* The client expects bare `repo` / `issue-term` attributes, which
                Astro's script typings reject; build the tag at runtime instead. */}
            <script
              is:inline
              define:vars={{
                repo: cfg.repo,
                issueTerm: cfg.issueTerm || "pathname",
                label: cfg.label || "comment",
                theme: utterancesTheme,
              }}
            >
              ;(() => {
                const script = document.createElement("script")
                script.src = "https://utteranc.es/client.js"
                script.setAttribute("repo", repo)
                script.setAttribute("issue-term", issueTerm)
                script.setAttribute("label", label)
                script.setAttribute("theme", theme)
                script.setAttribute("crossorigin", "anonymous")
                script.async = true
                document
                  .getElementById("utterances-comments")
                  ?.appendChild(script)
              })()
            </script>
          </div>
        )}

        {configured && provider === "waline" && (
          <>
            <div id="waline-comments" class="waline-container" />
            <link
              rel="stylesheet"
              href="https://unpkg.com/@waline/client@3.16.1/dist/waline.css"
            />
            <script
              is:inline
              type="module"
              define:vars={{ serverURL: cfg.serverURL, lang: cfg.lang || "zh-CN" }}
            >
              import { init } from "https://unpkg.com/@waline/client@3.16.1/dist/waline.js"
              init({
                el: "#waline-comments",
                serverURL,
                dark: "html.dark",
                lang,
              })
            </script>
          </>
        )}

        {configured && provider === "artalk" && (
          <>
            <div id="artalk-comments" class="artalk-container" />
            <link
              rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/artalk/2.9.1/Artalk.css"
            />
            <script
              is:inline
              type="module"
              define:vars={{
                server: cfg.server,
                site: cfg.site || siteConfig.title,
                locale: cfg.locale || "zh-CN",
                pagePath: path,
                pageTitle: title,
                darkMode: artalkDark,
              }}
            >
              import Artalk from "https://esm.sh/artalk@2.9.1"

              window.artalk = Artalk.init({
                el: "#artalk-comments",
                pageKey: pagePath,
                pageTitle,
                server,
                site,
                locale,
                darkMode:
                  darkMode === "auto"
                    ? document.documentElement.classList.contains("dark")
                      ? "dark"
                      : "light"
                    : darkMode,
                gravatar: { mirror: "https://cravatar.cn/avatar/" },
              })
            </script>
          </>
        )}

        {configured && provider === "twikoo" && (
          <div id="twikoo-comments" class="twikoo-container">
            <script
              is:inline
              src="https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.min.js"
            />
            <script
              is:inline
              define:vars={{
                envId: cfg.envId,
                region: cfg.region || "",
                lang: cfg.lang || "zh-CN",
                pagePath: cfg.path || path,
              }}
            >
              twikoo.init({
                envId,
                el: "#twikoo-comments",
                ...(region ? { region } : {}),
                path: pagePath,
                lang,
              })
            </script>
          </div>
        )}

        {configured && provider === "comentario" && (
          <div id="comentario-comments" class="comentario-container">
            <script
              is:inline
              defer
              src={`${(cfg.server ?? "").replace(/\/+$/, "")}/comentario.js`}
            />
            <comentario-comments
              page-id={path}
              domain-id={cfg.domainId || undefined}
              lang={cfg.lang || undefined}
              theme={cfg.theme || undefined}
              css-override={cfg.cssOverride || undefined}
              live-update={cfg.liveUpdate === "false" ? "false" : undefined}
              max-level={cfg.maxLevel || undefined}
              no-fonts={cfg.noFonts === "true" ? "true" : undefined}
              auto-init={cfg.autoInit === "false" ? "false" : undefined}
              auto-non-interactive-sso={cfg.autoNonInteractiveSso === "true"
                ? "true"
                : undefined}
            />
          </div>
        )}
      </div>
    </section>
  )}

{configured && provider === "giscus" && giscusTheme === "preferred_color_scheme" && (
    <CommentsThemeSync
      provider="giscus"
      container="#giscus-comments"
      initial={false}
    />
  )}

{configured && provider === "utterances" && utterancesTheme === "preferred-color-scheme" && (
    <CommentsThemeSync
      provider="utterances"
      container="#utterances-comments"
      initial={false}
    />
  )}

{configured && provider === "artalk" && artalkDark === "auto" && (
    <CommentsThemeSync provider="artalk" container="#artalk-comments" initial={false} />
  )}

{configured && provider === "twikoo" && (
    <CommentsThemeSync provider="twikoo" container="#twikoo-comments" initial={false} />
  )}

{configured && provider === "comentario" && !cfg.theme && (
    <CommentsThemeSync provider="comentario" container="#comentario-comments" />
  )}
