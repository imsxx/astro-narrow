---
type Props = {
  enabled?: boolean
}

const { enabled = true } = Astro.props
---

{
  enabled && (
    <script>
      const blocks = [...document.querySelectorAll<HTMLElement>(".mermaid")]
      if (blocks.length > 0) {
        const { default: mermaid } = await import("mermaid")

        const currentTheme = () =>
          document.documentElement.classList.contains("dark") ? "dark" : "default"

        for (const block of blocks) {
          if (!block.dataset.originalCode) {
            block.dataset.originalCode = block.textContent?.trim() ?? ""
          }
        }

        mermaid.initialize({
          startOnLoad: true,
          theme: currentTheme(),
          securityLevel: "loose",
        })

        window.addEventListener("themeChanged", async () => {
          for (const block of blocks) {
            const source = block.dataset.originalCode
            if (source) {
              block.removeAttribute("data-processed")
              block.textContent = source
            }
          }
          mermaid.initialize({
            startOnLoad: false,
            theme: currentTheme(),
            securityLevel: "loose",
          })
          await mermaid.run({ nodes: blocks })
        })
      }
    </script>
  )
}

<style>
  :global(svg[id^="mermaid-"]) {
    display: block;
    margin: 0 auto;
  }

  :global(.mermaid) {
    background: transparent;
    border: 0;
    padding: 1.5rem 0;
  }
</style>
