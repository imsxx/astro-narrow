---
const icons = import.meta.glob("../icons/*.svg", {
  eager: true,
  query: "?raw",
  import: "default",
}) as Record<string, string>

type Props = {
  name: string
  class?: string
  size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl"
  id?: string
  ariaLabel?: string
  hidden?: boolean
}

const { name, class: className = "", size, id, ariaLabel, hidden } = Astro.props

const sizeClasses = {
  xs: "h-3 w-3",
  sm: "h-4 w-4",
  md: "h-5 w-5",
  lg: "h-6 w-6",
  xl: "h-8 w-8",
  "2xl": "h-10 w-10",
}

const cls = [size ? sizeClasses[size] : "", className].filter(Boolean).join(" ")
const known = Object.keys(icons).some((path) => path.endsWith(`/${name}.svg`))
const decorative = hidden || !ariaLabel
---

{known ? (
    <svg
      class={cls}
      id={id}
      viewBox="0 0 24 24"
      role={decorative ? undefined : "img"}
      aria-label={decorative ? undefined : ariaLabel}
      aria-hidden={decorative ? "true" : undefined}
    >
      <use href={`/icons/sprite.svg#icon-${name}`} />
    </svg>
  ) : (
    <svg
      class={cls}
      id={id}
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      role={decorative ? undefined : "img"}
      aria-label={decorative ? undefined : ariaLabel}
      aria-hidden={decorative ? "true" : undefined}
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"
      />
    </svg>
  )}
