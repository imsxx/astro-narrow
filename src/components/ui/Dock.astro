---
import Icon from "@/components/Icon.astro"
import AppearancePopover from "@/components/ui/AppearancePopover.astro"
import { siteConfig } from "@/config/site"
import { t } from "@/i18n"

type Props = {
  showToc?: boolean
  showComments?: boolean
  isHome?: boolean
}

const { showToc = false, showComments = false, isHome = false } = Astro.props
import { url } from "@/lib/url"
---

<nav
  id="dock"
  role="toolbar"
  aria-label={t.ui.dockAriaLabel}
  aria-orientation="horizontal"
  data-placement="bottom"
>
  <div class="dock-shell">
    <a
      id="dock-home"
      href={url("/")}
      class="dock-item"
      title={t.nav.backHome}
      aria-label={t.nav.backHome}
      aria-current={isHome ? "page" : undefined}
    >
      <Icon name="home" size="sm" />
    </a>

    <button
      id="dock-menu"
      type="button"
      class="dock-item"
      aria-label={t.nav.menu}
      title={t.nav.menu}
      aria-controls="nav-menu-popover"
      aria-expanded="false"
      popovertarget="nav-menu-popover"
    >
      <span class="dock-menu-icon-expanded">
        <Icon name="categories" size="sm" />
      </span>
      <span class="dock-menu-icon-collapsed">
        <Icon name="menu" size="sm" />
      </span>
    </button>

    <button
      id="dock-search"
      type="button"
      class="dock-item"
      title={t.ui.dockSearch}
      aria-label={t.ui.dockSearch}
    >
      <Icon name="search" size="sm" />
    </button>

    {showToc && (
        <>
          <span class="dock-divider" aria-hidden="true" />
          <button
            id="dock-toc"
            type="button"
            class="dock-item"
            title={t.ui.toc}
            aria-label={t.ui.toc}
            aria-controls="toc-panel"
            aria-expanded="false"
          >
            <Icon name="book-open" size="sm" />
          </button>
        </>
      )}

    {showComments && (
        <>
          <span class="dock-divider" aria-hidden="true" />
          <button
            id="dock-comments"
            type="button"
            class="dock-item"
            title={t.ui.dockComments}
            aria-label={t.ui.dockComments}
          >
            <Icon name="message-circle" size="sm" />
          </button>
        </>
      )}

    <span class="dock-divider" aria-hidden="true" />

    <AppearancePopover />

    <button
      id="dock-top"
      type="button"
      class="dock-item"
      title={t.ui.dockBackToTop}
      aria-label={t.ui.dockBackToTop}
      hidden
    >
      <Icon name="arrow-up" size="sm" />
    </button>
  </div>
</nav>

{siteConfig.announcement.enabled && (
    <p hidden data-announcement-fallback>
      {siteConfig.announcement.message}
    </p>
  )}
