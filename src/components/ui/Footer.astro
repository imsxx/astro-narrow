---
import { siteConfig } from "@/config/site"
import { t } from "@/i18n"

const year = new Date().getFullYear()
---

<footer class="site-footer border-border mt-10 border-t py-6">
  <div
    class="text-muted-foreground flex flex-col gap-1 text-xs sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {siteConfig.title}</p>
    <p>
      {t.footer.poweredBy}&nbsp;
      <a
        href="https://astro.build/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-foreground transition-colors"
        >Astro</a
      >
      &amp;
      <a
        href="https://github.com/tom2almighty/hugo-narrow"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-foreground transition-colors"
        >Narrow</a
      >
    </p>
  </div>
</footer>
