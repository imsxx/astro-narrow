---
import Icon from "@/components/Icon.astro"
import { siteConfig } from "@/config/site"
import { t } from "@/i18n"
import type { NavItem } from "@/config/site"

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/"

const isActive = (item: NavItem) => {
  if (!item.href) return false
  const clean = item.href.replace(/\/+$/, "") || "/"
  return pathname === clean || pathname.startsWith(`${clean}/`)
}

const topLinks = siteConfig.nav.filter((item) => !item.children?.length)
const groups = siteConfig.nav.filter((item) => item.children?.length)

const inactive = "text-muted-foreground hover:bg-muted hover:text-foreground"
const active = "bg-accent text-accent-foreground font-medium"
const itemClass =
  "nav-panel-link flex h-8 items-center gap-2 rounded-md px-2.5 text-sm transition-colors"
---

<div
  id="nav-menu-popover"
  popover
  class="nav-popover text-popover-foreground border-border shadow-popover rounded-lg border p-2"
  aria-label={t.nav.menu}
>
  <div class="max-h-[75dvh] overflow-y-auto" data-nav-menu>
    <nav class="space-y-3" aria-label={t.nav.menu}>
      {topLinks.length > 0 && (
          <fieldset>
            <legend class="text-muted-foreground mb-1.5 px-1 text-xs font-medium">
              {t.nav.menu}
            </legend>
            <div class="grid grid-cols-2 gap-1">
              {topLinks.map((item) => (
                <a
                  href={item.href}
                  class:list={[itemClass, isActive(item) ? active : inactive]}
                  aria-current={isActive(item) ? "page" : undefined}
                >
                  {item.icon && <Icon name={item.icon} size="sm" class="shrink-0" />}
                  <span class="truncate">{item.label}</span>
                </a>
              ))}
            </div>
          </fieldset>
        )}

      {groups.map((group, index) => (
          <fieldset
            class:list={[
              (topLinks.length > 0 || index > 0) && "border-border border-t pt-3",
            ]}
          >
            <legend class="text-muted-foreground mb-1.5 px-1 text-xs font-medium">
              {group.label}
            </legend>
            <div class="grid grid-cols-2 gap-1">
              {group.children?.map((item) => (
                <a
                  href={item.href}
                  class:list={[itemClass, isActive(item) ? active : inactive]}
                  aria-current={isActive(item) ? "page" : undefined}
                >
                  {item.icon && <Icon name={item.icon} size="sm" class="shrink-0" />}
                  <span class="truncate">{item.label}</span>
                </a>
              ))}
            </div>
          </fieldset>
        ))}
    </nav>
  </div>
</div>
