---
import Icon from "@/components/Icon.astro"
import { colorSchemes } from "@/lib/themes"
import { t } from "@/i18n"
---

<button
  id="appearance-toggle"
  type="button"
  popovertarget="appearance-panel"
  aria-controls="appearance-panel"
  aria-expanded="false"
  aria-label={t.ui.appearanceToggle}
  title={t.ui.appearanceToggle}
  class="dock-item"
>
  <Icon name="palette" size="sm" />
</button>

<div
  id="appearance-panel"
  popover
  class="dock-popover text-popover-foreground border-border shadow-popover w-80 space-y-3 rounded-lg border p-2"
>
  <fieldset>
    <legend class="text-muted-foreground mb-1.5 px-1 text-xs font-medium">
      {t.ui.colorScheme}
    </legend>
    <div class="grid grid-cols-2 gap-0.5">
      {colorSchemes.map((scheme) => (
          <label class="block min-w-0">
            <input
              type="radio"
              name="color-scheme"
              value={scheme.key}
              class="peer sr-only"
            />
            <span class="text-muted-foreground hover:bg-muted hover:text-foreground peer-checked:bg-accent peer-checked:text-accent-foreground peer-focus-visible:ring-ring/50 flex h-8 w-full cursor-pointer items-center truncate rounded-md px-2 text-sm transition-colors peer-checked:font-medium peer-focus-visible:ring-2">
              {scheme.name}
            </span>
          </label>
        ))}
    </div>
  </fieldset>

  <fieldset class="border-border border-t pt-3">
    <legend class="text-muted-foreground mb-1.5 px-1 text-xs font-medium">
      {t.ui.themeMode}
    </legend>
    <div class="bg-muted grid grid-cols-3 gap-0.5 rounded-md p-0.5">
      {[
          { value: "light", label: t.ui.themeLight },
          { value: "dark", label: t.ui.themeDark },
          { value: "system", label: t.ui.themeSystem },
        ].map((mode) => (
          <label class="block">
            <input
              type="radio"
              name="theme-mode"
              value={mode.value}
              class="peer sr-only"
            />
            <span class="text-muted-foreground hover:text-foreground peer-checked:bg-background peer-checked:text-foreground peer-focus-visible:ring-ring/50 flex h-7 w-full cursor-pointer items-center justify-center rounded-sm px-2 text-xs font-medium transition-colors peer-focus-visible:ring-2">
              {mode.label}
            </span>
          </label>
        ))}
    </div>
  </fieldset>

  <fieldset class="border-border space-y-2 border-t pt-3">
    <div class="flex items-center justify-between px-1">
      <legend class="text-muted-foreground text-xs font-medium">
        {t.ui.contentWidth}
      </legend>
      <div class="flex items-center gap-2">
        <output
          id="content-width-value"
          for="content-width-range"
          class="text-muted-foreground font-mono text-xs tabular-nums"
        ></output>
        <button
          id="content-width-reset"
          type="button"
          class="text-muted-foreground hover:text-foreground text-xs transition-colors"
        >
          {t.ui.contentWidthReset}
        </button>
      </div>
    </div>
    <input
      id="content-width-range"
      class="w-full"
      type="range"
      min="40"
      max="90"
      step="1"
      aria-label={t.ui.contentWidth}
    >
  </fieldset>

  <fieldset class="border-border space-y-2 border-t pt-3">
    <div class="flex items-center justify-between px-1">
      <legend class="text-muted-foreground text-xs font-medium">
        {t.ui.backdropBlur}
      </legend>
      <div class="flex items-center gap-2">
        <output
          id="backdrop-blur-value"
          for="backdrop-blur-range"
          class="text-muted-foreground font-mono text-xs tabular-nums"
        ></output>
        <button
          id="backdrop-blur-reset"
          type="button"
          class="text-muted-foreground hover:text-foreground text-xs transition-colors"
        >
          {t.ui.backdropBlurReset}
        </button>
      </div>
    </div>
    <input
      id="backdrop-blur-range"
      class="w-full"
      type="range"
      min="0"
      max="24"
      step="1"
      aria-label={t.ui.backdropBlur}
    >
  </fieldset>

  <fieldset class="border-border space-y-2 border-t pt-3">
    <div class="flex items-center justify-between px-1">
      <legend class="text-muted-foreground text-xs font-medium">
        {t.ui.grainSize}
      </legend>
      <div class="flex items-center gap-2">
        <output
          id="grain-size-value"
          for="grain-size-range"
          class="text-muted-foreground font-mono text-xs tabular-nums"
        ></output>
        <button
          id="grain-size-reset"
          type="button"
          class="text-muted-foreground hover:text-foreground text-xs transition-colors"
        >
          {t.ui.grainSizeReset}
        </button>
      </div>
    </div>
    <input
      id="grain-size-range"
      class="w-full"
      type="range"
      min="0"
      max="100"
      step="5"
      aria-label={t.ui.grainSize}
    >
  </fieldset>
</div>
