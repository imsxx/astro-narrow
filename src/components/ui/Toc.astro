---
import Icon from "@/components/Icon.astro"
import { t } from "@/i18n"
import type { MarkdownHeading } from "astro"

type Props = {
  headings: MarkdownHeading[]
  enabled?: boolean
}

const { headings, enabled = true } = Astro.props

type TocNode = { id: string; text: string; children: TocNode[] }

function buildToc(items: MarkdownHeading[]): TocNode[] {
  const roots: TocNode[] = []
  let current: TocNode | null = null
  for (const heading of items) {
    // remark-gfm appends a screen-reader-only <h2 id="footnote-label"> heading.
    if (heading.slug === "footnote-label") continue
    if (heading.depth === 2) {
      current = { id: heading.slug, text: heading.text, children: [] }
      roots.push(current)
    } else if (heading.depth === 3 && current) {
      current.children.push({
        id: heading.slug,
        text: heading.text,
        children: [],
      })
    }
  }
  return roots
}

const escape = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")

function renderList(nodes: TocNode[]): string {
  return `<ul>${nodes
    .map((node) => {
      const child = node.children.length > 0 ? renderList(node.children) : ""
      return `<li><a href="#${node.id}">${escape(node.text)}</a>${child}</li>`
    })
    .join("")}</ul>`
}

const tree = buildToc(headings)
const tocHtml =
  tree.length > 0 ? `<nav id="TableOfContents">${renderList(tree)}</nav>` : ""
---

{enabled && tocHtml && (
    <aside
      id="toc-panel"
      class="toc-panel"
      data-open="false"
      aria-label={t.ui.toc}
      aria-hidden="true"
      inert
    >
      <div class="toc-panel-header">
        <h2 class="text-muted-foreground truncate text-xs font-medium">{t.ui.toc}</h2>
        <div class="flex shrink-0 items-center gap-0.5">
          <button
            id="toc-pin"
            type="button"
            class="dock-item"
            aria-pressed="false"
            aria-label={t.ui.tocPin}
            title={t.ui.tocPin}
            data-label-pin={t.ui.tocPin}
            data-label-unpin={t.ui.tocUnpin}
          >
            <span id="toc-pin-on">
              <Icon name="pin" size="sm" />
            </span>
            <span id="toc-pin-off">
              <Icon name="pin-off" size="sm" />
            </span>
          </button>
          <button
            id="toc-close"
            type="button"
            class="dock-item"
            aria-label={t.ui.tocClose}
            title={t.ui.tocClose}
          >
            <Icon name="close" size="sm" />
          </button>
        </div>
      </div>

      <div id="toc-content" class="toc-panel-content scrollbar-hide">
        <Fragment set:html={tocHtml} />
      </div>
    </aside>
  )}
