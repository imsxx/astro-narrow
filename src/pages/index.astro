---
import Base from "@/layouts/Base.astro"
import AuthorSection from "@/components/home/AuthorSection.astro"
import RecentPosts from "@/components/home/RecentPosts.astro"
import FeaturedProjects from "@/components/home/FeaturedProjects.astro"
import { siteConfig } from "@/config/site"

const known = ["author-section", "recent-posts", "featured-projects"]
const order = (siteConfig.home.contentOrder.length > 0
  ? siteConfig.home.contentOrder
  : known
).filter((name) => known.includes(name))
---

<Base title={siteConfig.title} description={siteConfig.description}>
  <div class="space-y-10">
    {order.map((name) => (
      <>
        {name === "author-section" && <AuthorSection />}
        {name === "recent-posts" && <RecentPosts />}
        {name === "featured-projects" && <FeaturedProjects />}
      </>
    ))}
  </div>
</Base>
