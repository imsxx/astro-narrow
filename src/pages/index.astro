---
import Base from "@/layouts/Base.astro"
import Icon from "@/components/Icon.astro"
import { siteConfig } from "@/config/site"
import { getPosts, readingTime, summaryOf } from "@/lib/posts"
import { formatDate, isoDate } from "@/lib/date"
import { t } from "@/i18n"

const posts = await getPosts()
const recent = posts.slice(0, siteConfig.home.recentPostsCount)
const author = siteConfig.author
const initial = author.name.trim().slice(0, 1).toUpperCase()
import { url } from "@/lib/url"
---

<Base title={siteConfig.title} description={siteConfig.description}>
  <div class="space-y-10">
    <section class="author-section">
      <div class="border-border bg-card rounded-lg border p-6 md:p-8">
        <div
          class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left"
        >
          <div class="shrink-0">
            {author.avatar ? (
                    <img
                      src={author.avatar}
                      alt={author.name}
                      class="border-border size-20 rounded-full border object-cover md:size-24"
                    />
                  ) : (
                    <div class="bg-muted text-foreground flex size-20 items-center justify-center rounded-full text-2xl font-semibold md:size-24">
                      {initial}
                    </div>
                  )}
          </div>

          <div class="min-w-0 flex-1">
            <h1 class="text-foreground text-2xl font-semibold tracking-tight">
              {author.name}
            </h1>
            {author.title && (
                    <p class="text-muted-foreground mt-1 text-base">{author.title}</p>
                  )}
            {author.description && (
                    <p class="text-foreground mt-3 text-sm leading-relaxed">
                      {author.description}
                    </p>
                  )}
            {author.social.length > 0 && (
                    <div class="mt-4 flex flex-wrap justify-center gap-1.5 md:justify-start">
                      {author.social.map((link) => (
                        <a
                          href={link.url}
                          target={link.url.startsWith("http") ? "_blank" : undefined}
                          rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
                          class="border-border bg-background text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex h-8 items-center gap-1.5 rounded-md border px-2.5 text-xs font-medium transition-colors"
                          title={link.name}
                        >
                          <Icon name={link.icon} size="sm" />
                          <span>{link.name}</span>
                        </a>
                      ))}
                    </div>
                  )}
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="mb-4 flex items-end justify-between gap-4">
        <h2 class="text-foreground text-lg font-semibold tracking-tight">
          {t.home.recentPosts}
        </h2>
        <a
          href={url("/posts")}
          class="text-muted-foreground hover:text-foreground text-sm transition-colors"
        >
          {t.home.viewAll}
        </a>
      </div>

      <ul class="space-y-4">
        {recent.map((post) => (
                <li class="border-border bg-card hover:border-foreground/20 rounded-lg border p-4 transition-colors md:p-5">
                  <a href={url(`/posts/${post.id}`)} class="group block">
                    <h3 class="text-foreground group-hover:text-primary text-base font-medium transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="text-muted-foreground mt-1.5 line-clamp-2 text-sm leading-relaxed">
                      {summaryOf(post)}
                    </p>
                  </a>
                  <div class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                    <time datetime={isoDate(post.data.date)}>
                      {formatDate(post.data.date)}
                    </time>
                    <span>{t.article.readingTime(readingTime(post.body ?? ""))}</span>
                    {post.data.tags.length > 0 && (
                      <div class="flex flex-wrap items-center gap-1.5">
                        {post.data.tags.map((tag) => (
                          <a
                            href={url(`/tags/${tag}`)}
                            class="border-border hover:bg-accent hover:text-accent-foreground inline-flex h-5 items-center rounded-md border px-1.5 text-xs transition-colors"
                          >
                            {tag}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              ))}
      </ul>
    </section>
  </div>
</Base>
