---
import Base from "@/layouts/Base.astro"
import { siteConfig } from "@/config/site"
import { t } from "@/i18n"
---

<Base
  title={`${t.notFound.title} | ${siteConfig.title}`}
  noindex
  showReadingProgress={false}
>
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <p
      class="text-muted-foreground font-mono text-6xl font-semibold tracking-tight"
    >
      404
    </p>
    <h1 class="text-foreground mt-4 text-xl font-semibold tracking-tight">
      {t.notFound.title}
    </h1>
    <p class="text-muted-foreground mt-2 text-sm">{t.notFound.message}</p>
    <a
      href="/"
      class="border-border bg-card hover:bg-accent hover:text-accent-foreground mt-6 inline-flex h-9 items-center rounded-md border px-4 text-sm font-medium transition-colors"
    >
      {t.nav.backHome}
    </a>
  </div>
</Base>
