---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import LinkCard from "@/components/embeds/LinkCard.astro"
import { siteConfig } from "@/config/site"
import { getEntry, render } from "astro:content"

const page = await getEntry("pages", "about")
if (!page) throw new Error("Missing src/content/pages/about.md")

const { Content } = await render(page)
---

<Base
  title={`${page.data.title} | ${siteConfig.title}`}
  description={page.data.summary}
  crumbs={[{ label: page.data.title }]}
>
  <PageHeader title={page.data.title} description={page.data.summary} />

  <div class="prose max-w-none">
    <Content />
  </div>

  {page.data.links.length > 0 && (
      <div class="not-prose mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {page.data.links.map((link) => (
          <LinkCard
            title={link.name}
            url={link.url}
            description={link.description}
            icon={link.icon}
          />
        ))}
      </div>
    )}
</Base>
