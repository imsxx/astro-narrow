---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import Card from "@/components/content/Card.astro"
import Icon from "@/components/Icon.astro"
import { siteConfig } from "@/config/site"
import { getPosts, summaryOf, type Post } from "@/lib/posts"
import { t } from "@/i18n"

const posts = await getPosts()

const years = new Map<number, Map<number, Post[]>>()
for (const post of posts) {
  const year = post.data.date.getFullYear()
  const month = post.data.date.getMonth() + 1
  const months = years.get(year) ?? new Map<number, Post[]>()
  const list = months.get(month) ?? []
  list.push(post)
  months.set(month, list)
  years.set(year, months)
}

const grouped = [...years]
  .sort((a, b) => b[0] - a[0])
  .map(([year, months]) => ({
    year,
    count: [...months.values()].reduce((sum, list) => sum + list.length, 0),
    months: [...months].sort((a, b) => b[0] - a[0]),
  }))

const monthLabel = (year: number, month: number) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "long",
    timeZone: "Asia/Shanghai",
  }).format(new Date(year, month - 1, 1))
import { url } from "@/lib/url"
---

<Base title={`归档 | ${siteConfig.title}`} crumbs={[{ label: "归档" }]}>
  <PageHeader title="归档" meta={t.list.pages(posts.length)} />

  {posts.length > 0 ? (
          <div class="relative">
            <div class="bg-border absolute top-0 bottom-0 left-4 w-0.5" aria-hidden="true" />

            {grouped.map((group) => (
              <div class="relative mb-10">
                <div class="relative mb-6 flex items-center">
                  <div class="bg-primary text-primary-foreground absolute left-0 z-10 flex size-8 items-center justify-center rounded-full">
                    <Icon name="calendar" size="sm" />
                  </div>
                  <div class="ml-12">
                    <h2 class="text-foreground text-xl font-semibold tracking-tight">
                      {group.year}
                    </h2>
                    <p class="text-muted-foreground text-xs">{t.list.pages(group.count)}</p>
                  </div>
                </div>

                {group.months.map(([month, list]) => (
                  <div class="relative mb-6">
                    <div class="relative mb-3 flex items-center">
                      <div
                        class="bg-accent border-background absolute left-2 z-10 size-4 rounded-full border-2"
                        aria-hidden="true"
                      />
                      <div class="ml-12">
                        <h3 class="text-foreground text-base font-semibold">
                          {monthLabel(group.year, month)}
                        </h3>
                        <p class="text-muted-foreground text-xs">
                          {t.list.pages(list.length)}
                        </p>
                      </div>
                    </div>

                    <div class="ml-12 space-y-3">
                      {list.map((post) => (
                        <Card
                          compact
                          title={post.data.title}
                          href={url(`/posts/${post.id}/`)}
                          summary={summaryOf(post)}
                          date={post.data.date}
                          tags={post.data.tags}
                        />
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground py-8 text-sm">{t.article.empty}</p>
        )}
</Base>
