---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import { siteConfig } from "@/config/site"
import { getSeries } from "@/lib/posts"
import { t } from "@/i18n"

const series = await getSeries()
const items = [...series]
  .map(([name, posts]) => ({
    name,
    href: `/series/${name}/`,
    count: posts.length,
    latest: posts.reduce(
      (latest, post) => (post.data.date > latest ? post.data.date : latest),
      posts[0].data.date,
    ),
  }))
  .sort((a, b) => b.latest.getTime() - a.latest.getTime())
---

<Base title={`系列 | ${siteConfig.title}`} crumbs={[{ label: "系列" }]}>
  <PageHeader title="系列" meta={t.list.terms(items.length)} />
  {items.length > 0 ? (
          <CardGrid columns={2}>
            {items.map((item) => (
              <Card
                variant="series"
                title={item.name}
                href={item.href}
                date={item.latest}
                count={item.count}
              />
            ))}
          </CardGrid>
        ) : (
          <p class="text-muted-foreground py-8 text-sm">{t.article.empty}</p>
        )}
</Base>
