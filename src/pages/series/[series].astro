---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import { siteConfig } from "@/config/site"
import { getSeries, summaryOf } from "@/lib/posts"
import { t } from "@/i18n"

export async function getStaticPaths() {
  const series = await getSeries()
  return [...series].map(([name, posts]) => ({
    params: { series: name },
    props: { name, posts },
  }))
}

const { name, posts } = Astro.props
import { url } from "@/lib/url"
---

<Base
  title={`${name} | ${siteConfig.title}`}
  crumbs={[{ label: "系列", href: "/series" }, { label: name }]}
>
  <PageHeader title={name} meta={t.list.pages(posts.length)} />
  <CardGrid columns={1}>
    {posts.map((post, index) => (
            <div class="flex items-start gap-3">
              <span class="text-muted-foreground mt-4 w-6 shrink-0 text-right text-xs tabular-nums">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0 flex-1">
                <Card
                  title={post.data.title}
                  href={url(`/posts/${post.id}/`)}
                  summary={summaryOf(post)}
                  date={post.data.date}
                  tags={post.data.tags}
                />
              </div>
            </div>
          ))}
  </CardGrid>
</Base>
