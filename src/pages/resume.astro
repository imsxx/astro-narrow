---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import { siteConfig } from "@/config/site"
import { getEntry, render } from "astro:content"

const page = await getEntry("pages", "resume")
if (!page) throw new Error("Missing src/content/pages/resume.md")

const { Content, headings } = await render(page)
---

<Base
  title={`${page.data.title} | ${siteConfig.title}`}
  description={page.data.summary}
  crumbs={[{ label: page.data.title }]}
  headings={headings}
>
  <PageHeader title={page.data.title} description={page.data.summary} />

  <div class="resume prose max-w-none">
    <Content />
  </div>
</Base>

<style>
  .resume :global(h2) {
    margin-block-start: 2.5rem;
    margin-block-end: 1rem;
    border-block-end: 1px solid var(--border);
    padding-block-end: 0.5rem;
    font-size: 1rem;
  }

  .resume :global(h3) {
    margin-block-start: 1.75rem;
    margin-block-end: 0.25rem;
    border-block-end: 1px solid var(--border);
    padding-block-end: 0.75rem;
    font-size: 0.875rem;
  }

  .resume :global(h3 + p) {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
</style>
