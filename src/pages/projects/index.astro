---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import Card from "@/components/content/Card.astro"
import CardGrid from "@/components/content/CardGrid.astro"
import { siteConfig } from "@/config/site"
import { getCollection } from "astro:content"
import { t } from "@/i18n"

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
import { url } from "@/lib/url"
---

<Base title={`项目 | ${siteConfig.title}`} crumbs={[{ label: "项目" }]}>
  <PageHeader title="项目" meta={t.list.pages(projects.length)} />

  {projects.length > 0 ? (
      <CardGrid columns={2}>
        {projects.map((project) => (
          <Card
            variant="post"
            title={project.data.title}
            href={url(`/projects/${project.id}/`)}
            summary={project.data.summary ?? project.data.description}
            date={project.data.date}
            tags={project.data.tags}
            external={project.data.link}
          />
        ))}
      </CardGrid>
    ) : (
      <p class="text-muted-foreground py-8 text-sm">{t.article.empty}</p>
    )}
</Base>
