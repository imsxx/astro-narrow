---
import Base from "@/layouts/Base.astro"
import Icon from "@/components/Icon.astro"
import { siteConfig } from "@/config/site"
import { formatDate, isoDate } from "@/lib/date"
import { getCollection, render } from "astro:content"
import { t } from "@/i18n"

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft)
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content, headings } = await render(project)
---

<Base
  title={`${project.data.title} | ${siteConfig.title}`}
  description={project.data.summary ?? project.data.description}
  crumbs={[{ label: "项目", href: "/projects" }, { label: project.data.title }]}
  headings={headings}
>
  <header class="border-border mb-8 border-b pb-6">
    <div class="flex items-start justify-between gap-4">
      <h1
        class="text-foreground text-2xl leading-tight font-semibold tracking-tight md:text-3xl"
      >
        {project.data.title}
      </h1>
      {project.data.link && (
        <a
          href={project.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border bg-card text-foreground hover:bg-accent hover:text-accent-foreground inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md border px-3 text-xs font-medium transition-colors"
        >
          <Icon name="external-link" size="sm" />
          <span>{t.projects.visit}</span>
        </a>
      )}
    </div>
    {(project.data.summary ?? project.data.description) && (
      <p class="text-muted-foreground mt-3 text-base leading-relaxed">
        {project.data.summary ?? project.data.description}
      </p>
    )}
  </header>

  <article class="prose max-w-none">
    <Content />
  </article>
</Base>
