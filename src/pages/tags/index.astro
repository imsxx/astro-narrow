---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import TermCloud from "@/components/content/TermCloud.astro"
import { siteConfig } from "@/config/site"
import { getTags } from "@/lib/posts"
import { t } from "@/i18n"

const tags = await getTags()
const terms = [...tags]
  .sort(
    (a, b) =>
      b[1].length - a[1].length || a[0].localeCompare(b[0], "zh-Hans-CN"),
  )
  .map(([name, posts]) => ({
    name,
    count: posts.length,
    href: `/tags/${name}/`,
  }))
---

<Base title={`标签 | ${siteConfig.title}`} crumbs={[{ label: "标签" }]}>
  <PageHeader title="标签" meta={t.list.terms(terms.length)} />
  {terms.length > 0 ? (
          <TermCloud terms={terms} />
        ) : (
          <p class="text-muted-foreground py-8 text-sm">{t.article.empty}</p>
        )}
</Base>
