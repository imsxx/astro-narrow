---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import PostFeed from "@/components/content/PostFeed.astro"
import { siteConfig } from "@/config/site"
import { getTags } from "@/lib/posts"
import { t } from "@/i18n"

export async function getStaticPaths() {
  const tags = await getTags()
  return [...tags].map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }))
}

const { tag, posts } = Astro.props
---

<Base title={`#${tag} | ${siteConfig.title}`}
  crumbs={[{ label: "标签", href: "/tags" }, { label: `#${tag}` }]}
>
      <PageHeader title={`#${tag}`} meta={t.list.pages(posts.length)} />
      <PostFeed posts={posts} base={`/tags/${tag}`} current={1} totalPages={1} />
</Base>
