---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import { siteConfig } from "@/config/site"
import { getEntry, render } from "astro:content"

const page = await getEntry("pages", "timeline")
if (!page) throw new Error("Missing src/content/pages/timeline.md")

const { Content, headings } = await render(page)
---

<Base
  title={`${page.data.title} | ${siteConfig.title}`}
  description={page.data.summary}
  crumbs={[{ label: page.data.title }]}
  headings={headings}
>
  <PageHeader title={page.data.title} description={page.data.summary} />

  <div class="timeline prose max-w-none">
    <Content />
  </div>
</Base>

<style>
  .timeline {
    border-inline-start: 1px solid var(--border);
    padding-inline-start: 1.5rem;
  }

  .timeline :global(h2) {
    position: relative;
    margin-block-start: 2.5rem;
    margin-block-end: 1rem;
    font-size: 1.125rem;
  }

  .timeline :global(h2)::before {
    content: "";
    position: absolute;
    inset-inline-start: -1.94rem;
    inset-block-start: 0.62rem;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 999px;
    background: var(--muted-foreground);
  }

  .timeline :global(h3) {
    margin-block-start: 1.5rem;
    margin-block-end: 0.5rem;
    font-size: 0.9375rem;
  }
</style>
