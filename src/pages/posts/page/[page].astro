---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import PostFeed from "@/components/content/PostFeed.astro"
import { siteConfig } from "@/config/site"
import { getPosts } from "@/lib/posts"
import { paginate } from "@/lib/pagination"
import { t } from "@/i18n"

export async function getStaticPaths() {
  const all = await getPosts()
  const totalPages = Math.ceil(all.length / siteConfig.pagination.pageSize)
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { pageNumber: index + 2 },
  }))
}

const { pageNumber } = Astro.props
const all = await getPosts()
const result = paginate(
  all,
  pageNumber,
  siteConfig.pagination.pageSize,
  "/posts",
)
---

<Base
  title={`文章 · 第 ${result.current} 页 | ${siteConfig.title}`}
  noindex={true}
  crumbs={[{ label: "文章", href: "/posts" }, { label: `第 ${result.current} 页` }]}
>
  <PageHeader title="文章" meta={t.list.pages(result.total)} />
  <PostFeed
    posts={result.items}
    base="/posts"
    current={result.current}
    totalPages={result.totalPages}
  />
</Base>
