---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/content/PageHeader.astro"
import PostFeed from "@/components/content/PostFeed.astro"
import { siteConfig } from "@/config/site"
import { getPosts } from "@/lib/posts"
import { paginate } from "@/lib/pagination"
import { t } from "@/i18n"

const all = await getPosts()
const result = paginate(all, 1, siteConfig.pagination.pageSize, "/posts")
---

<Base title={`${t.nav.home} · 文章 | ${siteConfig.title}`}
  crumbs={[{ label: "文章" }]}
>
      <PageHeader title="文章" meta={t.list.pages(result.total)} />
      <PostFeed
        posts={result.items}
        base="/posts"
        current={result.current}
        totalPages={result.totalPages}
      />
</Base>
